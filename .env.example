# Phase 1 — Knowledge Foundation: Environment Variables
# Copy to .env and fill in values before running locally.
# Never commit .env to version control.

# ── Vertex AI Search ──────────────────────────────────────────────────────────
# Vertex AI Search data store IDs (eu region)
VERTEX_SEARCH_DATASTORE_PRODUCTION=midwife-production
VERTEX_SEARCH_DATASTORE_STAGING=midwife-staging

# Vertex AI Search serving location (use "eu" for GDPR residency)
VERTEX_SEARCH_LOCATION=eu

# ── Google Cloud Platform ─────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=europe-west1

# ── Admin API Auth ────────────────────────────────────────────────────────────
# Static bearer token for X-Admin-Token header (change in production)
ADMIN_TOKEN=change-me-before-running

# ── Audit Log ─────────────────────────────────────────────────────────────────
# GCS bucket name for append-only JSONL audit log (no gs:// prefix)
AUDIT_BUCKET_NAME=midwife-bot-audit-dev

# ── Firestore Emulator ────────────────────────────────────────────────────────
# Leave blank in production; set to "localhost:8080" for local emulator
FIRESTORE_EMULATOR_HOST=localhost:8080

# ── AI Models ─────────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.0-flash-001
SPACY_MODEL=xx_ent_wiki_sm

# ── Extraction Pipeline ───────────────────────────────────────────────────────
# Cosine similarity threshold for near-duplicate detection (0–1)
DUPLICATE_SIMILARITY_THRESHOLD=0.92

# ── Frontend (Vite — VITE_ prefix required for browser exposure) ──────────────
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_TOKEN=change-me-before-running
